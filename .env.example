# Optional: enables live Claude analysis. Without it every AI route uses its offline fallback.
ANTHROPIC_API_KEY=

# Optional: Gemini picks real YouTube videos for the 45-minute study plan (grounded with Google Search).
# Without it the plan uses deterministic YouTube search links.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Accounts database (libSQL). Defaults to a local SQLite file at data/samajh.db.
# On Vercel the filesystem does not persist: create a free Turso DB and set both values.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
